# Every role talks to an OpenAI-compatible endpoint. Copy to .env and fill in.
# Role-specific vars (AGENT_*, SIM_*, JUDGE_*, IMPROVER_*) override the LLM_* defaults.
# Keep the JUDGE/IMPROVER model in a DIFFERENT model family from the AGENT, so the
# judge does not share the agent's blind spots.
#
# Example endpoints:
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (API key can be any non-empty string)

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=

SIM_BASE_URL=
SIM_API_KEY=
SIM_MODEL=

JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Improver falls back to JUDGE_* when unset.
IMPROVER_BASE_URL=
IMPROVER_API_KEY=
IMPROVER_MODEL=

# Harness knobs
EVAL_CONCURRENCY=2
LLM_CACHE_DIR=.llm_cache
LLM_MAX_RETRIES=6
