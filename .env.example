# Copy to .env (gitignored) and fill in the keys. Real environment variables override .env,
# so a one-off swap works too:  AGENT_PROVIDER=gemini AGENT_MODEL=gemini-3.5-flash-lite python ...
#
# Providers: groq | gemini | openrouter | ollama  (base URL + key variable are filled in by llm.py)
# Explicit {ROLE}_BASE_URL / {ROLE}_API_KEY override the provider defaults.

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Role -> provider + model. Keep JUDGE in a DIFFERENT model family from AGENT,
# so the judge does not share the agent's blind spots or prefer its style.
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-3.5-flash-lite
SIM_PROVIDER=groq
SIM_MODEL=openai/gpt-oss-20b
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
IMPROVER_PROVIDER=groq
IMPROVER_MODEL=openai/gpt-oss-120b

# Per-role client-side limits: requests/min, tokens/min, requests/day, tokens/day.
# 0 = unknown/unlimited. Set under your free-tier quota; verify in the provider console.
# Roles that point at the same provider+model share one limiter and one daily ledger.
AGENT_RPM=15
AGENT_TPM=200000
AGENT_RPD=450
AGENT_TPD=0
SIM_RPM=30
SIM_TPM=7000
SIM_RPD=900
SIM_TPD=190000
# Qwen on Groq also has a 1,000 output-tokens/minute limit: RPM 4 keeps ~230-token verdicts under it.
JUDGE_RPM=4
JUDGE_TPM=7000
JUDGE_RPD=900
JUDGE_TPD=190000
IMPROVER_RPM=30
IMPROVER_TPM=7000
IMPROVER_RPD=900
IMPROVER_TPD=180000

# Reasoning effort + output caps (reasoning tokens count toward TPM/TPD).
SIM_REASONING_EFFORT=low
SIM_MAX_TOKENS=400
JUDGE_REASONING_EFFORT=none
JUDGE_MAX_TOKENS=600
IMPROVER_REASONING_EFFORT=low
IMPROVER_MAX_TOKENS=3500

# Harness knobs
EVAL_CONCURRENCY=2
LLM_CACHE_DIR=.llm_cache
LLM_MAX_RETRIES=6
LLM_TIMEOUT=60
